# The devnull instance to talk to. Leave unset for production.
EXPO_PUBLIC_DEVNULL_URL=https://dev-null.sh

# App Review only. Base64 seed of a device key already approved on devnull for
# the demo account, and the passphrase App Review types as the password. Leave both
# unset for normal builds; the reviewer path is then not in the bundle.
# See docs/app-review.md.
#EXPO_PUBLIC_REVIEW_SEED=
#EXPO_PUBLIC_REVIEW_PASSPHRASE=
# The demo account's handle, the username App Review types. Defaults to null-pointer-auto.
#EXPO_PUBLIC_REVIEW_HANDLE=
