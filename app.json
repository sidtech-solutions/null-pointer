{
  "expo": {
    "name": "null-pointer",
    "slug": "null-pointer",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devnull",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.siddarthkay.nullpointer",
      "appleTeamId": "42R7J9G7R2",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.siddarthkay.nullpointer"]
      },
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.siddarthkay.nullpointer",
      "versionCode": 6,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#f6f7f8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*", "image/*"],
          "androidMultiIntentFilters": ["image/*"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 3
          },
          "iosAppGroupIdentifier": "group.com.siddarthkay.nullpointer"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (used by the home screen widget) creates its database, workers and input mergers by name; R8 must keep them whole.\n-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.ListenableWorker { *; }\n-keep class * extends androidx.work.InputMerger { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class com.reactnativeandroidwidget.** { *; }"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": ["./assets/fonts/Geist-SemiBold.ttf", "./assets/fonts/Geist-Regular.ttf", "./assets/fonts/GeistMono-Regular.ttf", "./assets/fonts/GeistMono-Medium.ttf"],
          "widgets": [
            {
              "name": "Streak",
              "label": "Commit streak",
              "description": "Your streak and the last seven days. Make it taller for your rank, your counts and the newest commits from people you follow.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "maxResizeHeight": "420dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widget-streak-preview.png"
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "null-pointer uses your photos to attach images to a commit.",
          "cameraPermission": "null-pointer uses the camera to take a photo for a commit.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-unsigned-release",
      "./plugins/with-gradle-wrapper-timeout",
      "./plugins/with-reproducible-build",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f6f7f8",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111112"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
