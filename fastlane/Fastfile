# Signing and TestFlight only; the archive is plain xcodebuild in .github/workflows/build.yml.
default_platform(:ios)

BUNDLE_ID = "com.siddarthkay.nullpointer"
# The share extension and the home screen widget are their own targets, each with its own App ID and profile.
APP_IDS = [BUNDLE_ID, "#{BUNDLE_ID}.share-extension", "#{BUNDLE_ID}.streak"]

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false,
  )
end

platform :ios do
  def keychain_name
    "null_pointer_ci_#{ENV['GITHUB_RUN_ID'] || 'local'}.keychain"
  end

  private_lane :setup_ci_keychain do
    next unless is_ci

    create_keychain(
      name: keychain_name,
      password: ENV.fetch("MATCH_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    keychain = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    login = File.expand_path("~/Library/Keychains/login.keychain-db")
    sh("security", "list-keychains", "-d", "user", "-s", keychain, login)
  end

  error do |_lane, _exception|
    delete_keychain(name: keychain_name) rescue nil if is_ci
  end

  desc "Run once, locally, with the API key: register the share extension and widget App IDs and switch on App Groups for all three. Attaching the group itself is the one step Apple's API does not offer; the lane prints it."
  lane :register_targets do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    group = "group.#{BUNDLE_ID}"
    names = { BUNDLE_ID => "null-pointer", "#{BUNDLE_ID}.share-extension" => "null-pointer Share", "#{BUNDLE_ID}.streak" => "null-pointer Streak" }

    APP_IDS.each do |id|
      bundle = Spaceship::ConnectAPI::BundleId.find(id, includes: "bundleIdCapabilities")

      if bundle
        UI.message("#{id}: already registered")
      else
        bundle = Spaceship::ConnectAPI::BundleId.create(name: names[id], platform: Spaceship::ConnectAPI::Platform::IOS, identifier: id)
        UI.success("#{id}: registered")
      end

      has_groups = (bundle.bundle_id_capabilities || []).compact.any? { |c| c.is_type?(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS) }

      if has_groups
        UI.message("#{id}: App Groups already on")
      else
        bundle.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
        UI.success("#{id}: App Groups switched on")
      end
    end

    UI.important("Last step, by hand: https://developer.apple.com/account/resources/identifiers/list/applicationGroup")
    UI.important("  1. Register the group #{group} if it is not there.")
    UI.important("  2. For each of #{APP_IDS.join(', ')}: Identifiers > the App ID > App Groups > Configure > tick #{group} > Save.")
    UI.important("Then: bundle exec fastlane ios init_certs")
  end

  desc "Run once, locally, after register_targets: create or renew the App Store profiles for all three targets in the match repo (the certificate is reused)."
  lane :init_certs do
    match(type: "appstore", app_identifier: APP_IDS, api_key: asc_api_key, readonly: false, force: true)
  end

  desc "Install the App Store certificate and the three profiles, then pin each target to its profile. Read-only on CI."
  lane :match_release do
    setup_ci_keychain

    params = { type: "appstore", app_identifier: APP_IDS, api_key: asc_api_key, readonly: is_ci }

    if is_ci
      params[:keychain_name] = keychain_name
      params[:keychain_password] = ENV.fetch("MATCH_PASSWORD")
    end

    match(**params)

    # One profile per target. A single PROVISIONING_PROFILE_SPECIFIER on the
    # xcodebuild command line would be forced onto the extensions too and fail.
    { "nullpointer" => BUNDLE_ID, "ShareExtension" => "#{BUNDLE_ID}.share-extension", "streak" => "#{BUNDLE_ID}.streak" }.each do |target, id|
      update_code_signing_settings(
        path: "ios/nullpointer.xcodeproj",
        targets: [target],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        bundle_identifier: id,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{id}",
      )
    end
  end

  desc "Delete the per-run CI keychain."
  lane :clean_keychain do
    delete_keychain(name: keychain_name) if is_ci && File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}-db"))
  end

  desc "Upload an already-built IPA to TestFlight: fastlane ios upload_testflight ipa:path/to.ipa"
  lane :upload_testflight do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: options.fetch(:ipa),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
